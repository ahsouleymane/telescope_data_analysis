# Copy to .env and adapt (docker compose reads .env automatically). Never commit .env.
# Folder holding the cleaned data or the raw messages (JSONL files or ZIP archives); mounted read-only on /raw.
RAW_DIR=/path/to/raw_or_zip_folder
# Spark temporary files: internal disk, several tens of GB free.
SPARK_TMP=/path/to/spark_tmp
# Resources given to Spark (same defaults as the project: 3 cores, 4 GB). Keep them identical on every machine.
TELESCOPE_CORES=3
TELESCOPE_SPARK_MEMORY=4g
# Python of the image. Your .venv uses 3.13.
PYTHON_VERSION=3.13
# Your user and group ids (run `id -u` and `id -g`), so the output files are yours.
HOST_UID=1000
HOST_GID=1000